# Python 缓存
__pycache__/
*.py[cod]

# 测试和代码检查缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Python 打包产物
*.egg-info/
build/
dist/

# 环境变量和密钥
.env
.env.*

# 日志文件
logs/*.log

# 原始数据和中间数据
data/raw/*
data/interim/*
data/processed/*
data/parsed/*
# 知识库候选构建产物（规范化正文、阅读副本、父块、索引）；不进入 Git
data/knowledge-builds/

# 其他分支保留的论文数据层与本地中间产物
data/l0_raw/
data/l1_entities/
data/l2_evidence/
data/l3_benchmark/
tmp/

# 保留空目录
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/parsed/.gitkeep

# 编辑器配置
.vscode/
.idea/

# 系统文件
.DS_Store

# RAG vendored PDF.js runtime files are source assets, not Python build output
!src/accelerator_rag/rag/web/pdfjs/build/

