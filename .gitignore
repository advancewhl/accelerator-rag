# Python 缓存
__pycache__/
*.py[cod]

# 测试和代码检查缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Python 打包产物
*.egg-info/
build/
dist/

# 环境变量和密钥
.env
.env.*

# 日志文件
logs/*.log

# 原始数据和中间数据
data/raw/*
data/interim/*
data/processed/*
data/parsed/*
# 知识库候选构建产物（规范化正文、阅读副本、父块、索引）；不进入 Git
data/knowledge-builds/

# 其他分支保留的论文数据层与本地中间产物
data/l0_raw/
data/l1_entities/
data/l2_evidence/
data/l3_benchmark/
tmp/

# 保留空目录
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/parsed/.gitkeep

# 编辑器配置
.vscode/
.idea/

# 系统文件
.DS_Store

# RAG vendored PDF.js runtime files are source assets, not Python build output
!src/accelerator_rag/rag/web/pdfjs/build/

# RAG paper previews and reproducible compiler/process outputs
/papers/rag-thesis/qa/*.png
/papers/rag-paper/qa/*.png
/papers/rag-paper/main.aux
/papers/rag-paper/main.bbl
/papers/rag-paper/main.blg
/papers/rag-paper/main.log
/papers/rag-paper/main.out
/papers/rag-paper/main.pdf
/output/paper/
/output/paper-v2/
/output/rag-paper-source.zip
/output/pdf/rag-paper-font-fixed.pdf
/output/prompts/codex-paper-rewrite-20261027.md

# 仅本地存档：含内部文档原文或逐字证据，不进入 Git
/reports/incoming-*/
/reports/knowledge-base-v2/prod/trace-*.json
/reports/knowledge-base-v2/prod/ocr-*.json
/reports/validity-pilot-online-20261030/traces/
# 100 题回归运行明细：含内部文档逐字引用与完整答案，仅本地保存；汇总 README/comparison 仍入库
/reports/benchmark-100-*/rc*.json
/reports/benchmark-100-*/scoped30-*.json
